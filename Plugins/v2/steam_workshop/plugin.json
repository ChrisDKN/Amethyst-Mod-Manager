{
  "api_version": 1,
  "id": "amethyst.steam_workshop",
  "name": "Steam Workshop",
  "version": "1.3.2",
  "author": "ChrisDKN",
  "min_manager_version": "2.6.0",
  "description": "Browse Steam Workshop, resolve requirements, and download or install mods for the selected game and profile.",
  "entrypoint": "main.py",
  "ui": "qt",
  "methods": [
    "downloads.list",
    "downloads.install.start",
    "mods.set_enabled.start"
  ],
  "ui_extensions": [
    {
      "id": "open",
      "label": "Workshop",
      "type": "button",
      "location": "providers",
      "icon": "steam.png",
      "action": "open_tab",
      "target": "browser",
      "game_visibility": "workshop_support"
    },
    {
      "id": "browser",
      "label": "Workshop",
      "type": "widget",
      "location": "tab",
      "game_visibility": "workshop_support"
    }
  ],
  "service": true,
  "menu_tab": "browser"
}
