{
  "api_version": 1,
  "id": "amethyst.steam_workshop",
  "name": "Steam Workshop",
  "version": "1.5.3",
  "author": "ChrisDKN",
  "min_manager_version": "2.6.0",
  "description": "Browse Steam Workshop, subscribe on Steam, or download and install mods for the selected game and profile.",
  "entrypoint": "main.py",
  "ui": "qt",
  "methods": [
    "downloads.list",
    "downloads.install.start",
    "mods.set_enabled.start"
  ],
  "ui_extensions": [
    {
      "id": "open",
      "label": "Workshop",
      "type": "button",
      "location": "providers",
      "icon": "steam.png",
      "action": "open_tab",
      "target": "browser",
      "game_visibility": "workshop_support"
    },
    {
      "id": "browser",
      "label": "Workshop",
      "type": "widget",
      "location": "tab",
      "game_visibility": "workshop_support"
    }
  ],
  "service": true,
  "modlist_sections": [
    {
      "id": "subscribed",
      "label": "Subscribed mods",
      "actions": [
        {"id": "unsubscribe", "label": "Unsubscribe on Steam"},
        {"id": "open", "label": "Open on Steam Workshop"},
        {"id": "copy", "label": "Copy Workshop URL"},
        {"id": "refresh", "label": "Refresh subscriptions", "selection": "section"},
        {"id": "login", "label": "Sign in to Steam", "selection": "section"}
      ]
    }
  ],
  "menu_tab": "browser"
}
