  "mod_required_file_types": [],
  "mod_install_as_is_if_no_match": true,
  "restore_before_deploy": true,
  "normalize_folder_case": true,
  "filemap_casing": "upper",
  "wine_dll_overrides": {
    "winmm": "native,builtin",
    "dwmapi": "native,builtin"
  },
  "custom_routing_rules": [
    {
      "dest": "Content/Paks/~mods",
      "folders": [
        "windows"
      ],
      "include_siblings": true
    },
    {
      "dest": "Content/Paks/~mods",
      "extensions": [
        ".pak",
        ".ucas",
        ".utoc"
      ],
      "flatten": true
    },
    {
      "dest": "Content/Splash",
      "filenames": [
        "Splash.bmp"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64",
      "filenames": [
        "winmm.dll",
        "s2ae.cfg",
        "winmm.cfg",
        "dwmapi.dll"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64",
      "folders": [
        "ue4ss"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64/ue4ss",
      "folders": [
        "Mods",
        "ue4ss_signatures"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64/ue4ss",
      "filenames": [
        "ue4ss.dll",
        "ue4ss-settings.ini"
      ],
      "flatten": true
    },
    {
      "dest": "Unused",
      "filenames": [
        "*.*"
      ],
      "include_siblings": true
    }
  ],
  "restore_whitelist": [],
  "custom_frameworks": {},
  "version": 3,
  "editable": false
