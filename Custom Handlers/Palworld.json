{
  "name": "Palworld",
  "game_id": "Palworld",
  "exe_name": "Pal/Binaries/Win64/Palworld-Win64-Shipping.exe",
  "deploy_type": "ue5",
  "mod_data_path": "Pal",
  "steam_id": "1623730",
  "nexus_game_domain": "palworld",
  "additional_nexus_domains": [],
  "thunderstore_community": "palworld",
  "image_url": "https://cdn2.steamgriddb.com/icon/74428c0a6c8f499e67f96908f425fdd3/32/256x256.png",
  "mod_folder_strip_prefixes": [
    "Pal",
    "Binaries",
    "Win64",
    "Mods",
    "Content",
    "Paks",
    "LogicMods"
  ],
  "conflict_ignore_filenames": [
    "*.png",
    "*.jpg",
    "*readme*.txt",
    "*.md",
    "icon.png",
    "manifest.json",
    "LocalizationExample.zip",
    "*read*.txt"
  ],
  "conflict_ignore_foldernames": [],
  "mod_folder_strip_prefixes_post": [],
  "mod_install_prefix": "",
  "mod_required_top_level_folders": [],
  "mod_auto_strip_until_required": true,
  "mod_required_file_types": [],
  "mod_install_as_is_if_no_match": true,
  "restore_before_deploy": true,
  "normalize_folder_case": true,
  "filemap_casing": "upper",
  "wine_dll_overrides": {
    "d3d9": "native,builtin",
    "dwmapi": "native,builtin"
  },
  "custom_routing_rules": [
    {
      "dest": "drive_c/users/steamuser/AppData/Local/Pal/Saved/Config/Windows",
      "filenames": [
        "Engine.ini"
      ],
      "flatten": true,
      "to_prefix": true
    },
    {
      "dest": "drive_c/users/steamuser/AppData/Local/Pal/Saved/Config/Windows",
      "filenames": [
        "Scalability.ini"
      ],
      "flatten": true,
      "to_prefix": true
    },
    {
      "dest": "Binaries/Win64",
      "folders": [
        "ue4ss",
        "UE4SS_Signatures"
      ],
      "flatten": true
    },
    {
      "dest": "Content/Paks",
      "folders": [
        "LogicMods",
        "~mods"
      ],
      "flatten": true
    },
    {
      "dest": "Content/Paks/~mods",
      "extensions": [
        ".pak"
      ],
      "companion_extensions": [
        ".utoc",
        ".ucas",
        ".modconfig.json"
      ]
    },
    {
      "dest": "Content/Paks/~mods",
      "folders": [
        "SwapJSON"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64/ue4ss/Mods",
      "filenames": [
        "Main.lua"
      ],
      "include_siblings": true
    },
    {
      "dest": "Binaries/Win64/ue4ss/Mods",
      "filenames": [
        "enabled.txt"
      ],
      "include_siblings": true
    },
    {
      "dest": "Binaries/Win64/ue4ss/Mods",
      "folders": [
        "Scripts"
      ],
      "include_siblings": true
    },
    {
      "dest": "Binaries/Win64/ue4ss/Mods",
      "folders": [
        "Shared",
        "PalSchema"
      ],
      "flatten": true
    },
    {
      "dest": "Binaries/Win64/ue4ss/Mods/PalSchema/mods",
      "folders": [
        "appearance",
        "blueprints",
        "buildings",
        "enums",
        "helpguide",
        "items",
        "npcs",
        "pals",
        "raw",
        "resources",
        "skins",
        "spawns",
        "translations"
      ],
      "include_siblings": true
    },
    {
      "dest": "Content/Paks/~mods/SwapJSON",
      "extensions": [
        ".json"
      ],
      "loose_only": true
    }
  ],
  "restore_whitelist": [],
  "custom_frameworks": {
    "UE4SS": "Binaries/Win64/dwmapi.dll",
    "PalSchema": "Binaries/Win64/ue4ss/Mods/PalSchema/dlls/main.dll"
  },
  "version": 8,
  "editable": false
}
